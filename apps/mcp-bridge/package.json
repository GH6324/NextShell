{
  "name": "@nextshell/mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-credential stdio bridge between MCP clients and a running NextShell app",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nextshell-mcp-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild ./src/index.ts --bundle --outfile=dist/index.js --platform=node --format=esm --target=node24 --banner:js=\"#!/usr/bin/env node\"",
    "build:cli": "esbuild ./src/cli.ts --bundle --outfile=dist/cli.js --platform=node --format=esm --target=node24 --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "undici": "^7.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
